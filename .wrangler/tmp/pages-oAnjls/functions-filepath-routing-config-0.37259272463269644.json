{
  "routes": [
    {
      "routePath": "/api/manga/:id/viewed",
      "mountPath": "/api/manga/:id",
      "method": "POST",
      "module": [
        "api/manga/[id]/viewed.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/auth/login",
      "mountPath": "/api/auth",
      "method": "POST",
      "module": [
        "api/auth/login.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/auth/logout",
      "mountPath": "/api/auth",
      "method": "POST",
      "module": [
        "api/auth/logout.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/auth/me",
      "mountPath": "/api/auth",
      "method": "GET",
      "module": [
        "api/auth/me.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/auth/register",
      "mountPath": "/api/auth",
      "method": "POST",
      "module": [
        "api/auth/register.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/manga/:id",
      "mountPath": "/api/manga",
      "method": "GET",
      "module": [
        "api/manga/[id].js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/manga",
      "mountPath": "/api/manga",
      "method": "GET",
      "module": [
        "api/manga/index.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/manga",
      "mountPath": "/api/manga",
      "method": "POST",
      "module": [
        "api/manga/index.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}